<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_lavender"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Header ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/dark_purple"
            android:paddingTop="22dp"
            android:paddingBottom="16dp"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="הוספת תרומה"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:gravity="center_vertical">

                <TextView
                    style="@style/StepText"
                    android:background="@drawable/step_indicator_done"
                    android:text="✓"
                    android:textColor="@color/white"/>

                <View android:layout_width="24dp" android:layout_height="1dp"
                    android:background="@color/lavender" android:alpha="0.4"/>

                <TextView
                    style="@style/StepText"
                    android:background="@drawable/step_indicator_active"
                    android:text="2"
                    android:textColor="@color/dark_purple"/>

                <View android:layout_width="24dp" android:layout_height="1dp"
                    android:background="@color/lavender" android:alpha="0.4"/>

                <TextView
                    style="@style/StepText"
                    android:background="@drawable/step_indicator_idle"
                    android:text="3"
                    android:textColor="@color/lavender"
                    android:alpha="0.5"/>

                <View android:layout_width="24dp" android:layout_height="1dp"
                    android:background="@color/lavender" android:alpha="0.4"/>

                <TextView
                    style="@style/StepText"
                    android:background="@drawable/step_indicator_idle"
                    android:text="4"
                    android:textColor="@color/lavender"
                    android:alpha="0.5"/>

            </LinearLayout>
        </LinearLayout>

        <!-- ===== תוכן ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- קטגוריה שנבחרה -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/white"
                android:padding="12dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imgCategory"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"/>

                <TextView
                    android:id="@+id/tvCategoryName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_purple"
                    android:layout_marginStart="20dp"/>

            </LinearLayout>

            <!-- שם תרומה -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="שם התרומה"
                android:textSize="15sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etDonationName_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="כתבו את שם התרומה..."
                android:layout_marginBottom="14dp"
                app:boxStrokeColor="@color/lavender"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="@color/text_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDonationName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/dark_purple"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- תיאור -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="תיאור התרומה"
                android:textSize="15sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="פרטו: צבע, מצב, שימוש קודם וכל פרט אחר רלוונטי"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etDescription_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="כתבו תיאור מפורט..."
                android:layout_marginBottom="14dp"
                app:boxStrokeColor="@color/lavender"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="@color/text_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:maxLines="6"
                    android:textColor="@color/dark_purple"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- עיר -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="עיר"
                android:textSize="15sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/actCity_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="בחרי עיר"
                android:layout_marginBottom="20dp"
                app:boxStrokeColor="@color/lavender"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="@color/text_muted">
                <AutoCompleteTextView
                    android:padding="12dp"
                    android:id="@+id/actCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:completionThreshold="1"
                    android:textColor="@color/dark_purple"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextToUploadPic"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="המשך להוספת תמונה"
                android:textSize="17sp"
                android:backgroundTint="@color/dark_purple"
                android:textColor="@color/light_lavender"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>