<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_lavender"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Header סגול ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/dark_purple"
            android:gravity="center"
            android:paddingTop="48dp"
            android:paddingBottom="28dp"
            android:paddingHorizontal="24dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/logonobackground"
                android:background="@drawable/circle_background"
                android:layout_marginBottom="12dp"/>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="כניסה"
                android:textSize="30sp"
                android:textColor="@color/white"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ברוכים השבים!"
                android:textSize="17sp"
                android:textColor="@color/lavender"
                android:layout_marginTop="4dp"
                android:alpha="0.85"/>

        </LinearLayout>

        <!-- ===== גוף הטופס ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- שם משתמש -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/usernameInput_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="שם משתמש"
                android:layout_marginBottom="12dp"
                app:boxStrokeColor="@color/lavender"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="@color/text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/usernameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/dark_purple"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- סיסמה -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordInput_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="סיסמה"
                android:layout_marginBottom="8dp"
                app:endIconMode="password_toggle"
                app:boxStrokeColor="@color/lavender"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="@color/text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/dark_purple"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- שכחת סיסמה -->
            <TextView
                android:id="@+id/tv_login_to_resetpw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="שכחת את הסיסמה?"
                android:textSize="16sp"
                android:textColor="@color/medium_purple"
                android:layout_marginBottom="16dp"/>

            <!-- כפתור כניסה -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login_toHome"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="כניסה"
                android:textSize="18sp"
                android:backgroundTint="@color/dark_purple"
                android:textColor="@color/light_lavender"
                app:cornerRadius="12dp"/>

            <!-- קו הפרדה -->
            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/lavender"
                android:layout_marginVertical="20dp"/>

            <!-- לינק להרשמה -->
            <TextView
                android:id="@+id/tv_login_to_register"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="אין לך משתמש? הרשמה"
                android:textSize="15sp"
                android:textColor="@color/text_muted"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>