<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_lavender"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- ===== כותרת + שם ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="הפרופיל שלי"
                android:textSize="17sp"
                android:textColor="@color/text_muted"/>

            <!-- ===== תמונת פרופיל ===== -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgProfile"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                app:strokeColor="@color/medium_purple"
                app:strokeWidth="2.5dp"/>

            <TextView
                android:id="@+id/tvFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="שם מלא"
                android:textSize="25sp"
                android:textColor="@color/dark_purple"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="username"
                android:textSize="19sp"
                android:textColor="@color/text_muted"/>

            <!-- תג אדמין -->
            <TextView
                android:id="@+id/tvAdminState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="מנהל"
                android:textSize="15sp"
                android:textColor="@color/dark_purple"
                android:background="@drawable/badge_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:visibility="gone"
                tools:visibility="visible"/>

        </LinearLayout>

        <!-- ===== סטטיסטיקות ===== -->
        <LinearLayout
            android:id="@+id/layoutPublicInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/lavender"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvDonationCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textColor="@color/dark_purple"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="תרומות"
                        android:textSize="15sp"
                        android:textColor="@color/text_muted"/>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLevel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/lavender"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgMedal"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_bronze"/>

                        <TextView
                            android:id="@+id/tvLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ארד"
                            android:textSize="20sp"
                            android:textColor="@color/dark_purple"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="רמה"
                        android:textSize="15sp"
                        android:textColor="@color/text_muted"/>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ===== דירוג ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/lavender"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <!-- כוכבים -->
                <RatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:stepSize="0.1"
                    style="@style/Widget.AppCompat.RatingBar.Small"
                    app:tint="@color/medium_purple"/>

                <!-- ממוצע -->
                <TextView
                    android:id="@+id/tvRatingAvg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="15sp"
                    android:textColor="@color/dark_purple"
                    android:textStyle="bold"/>

                <!-- כמות -->
                <TextView
                    android:id="@+id/tvRatingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- טרם דורג -->
        <TextView
            android:id="@+id/tvNoRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:text="טרם דורג"
            android:textSize="13sp"
            android:textColor="@color/text_muted"
            android:visibility="gone"
            tools:visibility="visible"/>
        <!-- ===== כפתור צ'אט ===== -->
        <LinearLayout
            android:id="@+id/layoutChatRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <Button
                android:id="@+id/btnChat"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="המשך שיחה"
                android:backgroundTint="@color/lavender"
                android:textColor="@color/dark_purple"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== פרטי קשר ===== -->
        <TextView
            android:id="@+id/tvContactTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="פרטי קשר"
            android:textSize="17sp"
            android:textColor="@color/text_muted"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutContactInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/lavender"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- טלפון -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_phone"
                        android:layout_marginEnd="10dp"
                        app:tint="@color/medium_purple"/>

                    <TextView
                        android:id="@+id/tvPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="טלפון"
                        android:textSize="17sp"
                        android:textColor="@color/dark_purple"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/lavender"
                    android:layout_marginHorizontal="14dp"/>

                <!-- מייל -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_email"
                        android:layout_marginEnd="10dp"
                        app:tint="@color/medium_purple"/>

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="מייל"
                        android:textSize="17sp"
                        android:textColor="@color/dark_purple"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/lavender"
                    android:layout_marginHorizontal="14dp"/>

                <!-- תאריך לידה -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_calendar"
                        android:layout_marginEnd="10dp"
                        app:tint="@color/medium_purple"/>

                    <TextView
                        android:id="@+id/tvBirthday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="תאריך לידה"
                        android:textSize="17sp"
                        android:textColor="@color/dark_purple"/>
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== כפתור עריכה ===== -->
        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:text="עריכת פרטים"
            android:backgroundTint="@color/dark_purple"
            android:textColor="@color/light_lavender"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible"
            app:cornerRadius="12dp"/>

        <!-- =====  תרומות ===== -->
        <LinearLayout
            android:id="@+id/layoutDonationsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="תרומות"
                    android:textSize="17sp"
                    android:textColor="@color/text_muted"/>

                <Button
                    android:id="@+id/btnViewAllDonations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="הצג הכל"
                    android:textSize="15sp"
                    android:textColor="@color/medium_purple"
                    style="@style/Widget.Material3.Button.TextButton"/>
            </LinearLayout>

        </LinearLayout>

        <!-- קרוסלת תרומות (מחוץ ל-padding כדי לאפשר scroll מקצה לקצה) -->
        <RelativeLayout
            android:id="@+id/layoutDonationsCarousel"
            android:layout_width="match_parent"
            android:layout_height="190dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUserDonations"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                tools:visibility="invisible"/>

            <ImageButton
                android:id="@+id/btnLeft"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:background="@drawable/badge_background"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/dark_purple"/>

            <ImageButton
                android:id="@+id/btnRight"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="4dp"
                android:background="@drawable/badge_background"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/dark_purple"/>

            <LinearLayout
                android:id="@+id/emptyDonationsView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:alpha="0.25"
                    android:src="@drawable/ic_giving_heart"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="אין תרומות להצגה"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp"/>
            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</ScrollView>