<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_lavender"
    android:layoutDirection="rtl"
    tools:context=".screens.UsersListActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== כותרת + FAB ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ניהול"
                    android:textSize="17sp"
                    android:textColor="@color/text_muted"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="רשימת משתמשים"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_purple"
                    android:layout_marginTop="2dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/badge_background"
                    android:backgroundTint="@color/lavender"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_profile"
                        android:layout_marginEnd="6dp"
                        app:tint="@color/medium_purple"/>

                    <TextView
                        android:id="@+id/tv_user_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="סה״כ: 0"
                        android:textSize="15sp"
                        android:textColor="@color/medium_purple"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

            <!-- כפתור הוספה -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/fab_add_user"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="הוסף משתמש"
                android:textSize="15sp"
                android:textColor="@color/light_lavender"
                android:backgroundTint="@color/dark_purple"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/baseline_add_circle_24"
                app:iconTint="@color/light_lavender"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:cornerRadius="12dp"/>

        </LinearLayout>

        <!-- ===== חיפוש ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/lavender"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:layout_marginEnd="8dp"
                    app:tint="@color/text_muted"/>

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="חיפוש לפי שם משתמש..."
                    android:textColorHint="@color/text_muted"
                    android:textSize="16sp"
                    android:textColor="@color/dark_purple"
                    android:inputType="text"
                    android:singleLine="true"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Chips ===== -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="הכל"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:checked="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_admin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="אדמין"
                style="@style/Widget.MaterialComponents.Chip.Filter"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_not_admin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="משתמש רגיל"
                style="@style/Widget.MaterialComponents.Chip.Filter"/>

        </com.google.android.material.chip.ChipGroup>

        <!-- ===== כותרת רשימה ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="משתמשים"
            android:textSize="16sp"
            android:textColor="@color/text_muted"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="6dp"/>

        <!-- ===== תוכן ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_users_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp"
                android:clipToPadding="false"
                tools:listitem="@layout/item_user"
                tools:visibility="visible"/>

            <LinearLayout
                android:id="@+id/layout_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_giving_heart"
                    android:alpha="0.4"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="אין משתמשים רשומים"
                    android:textSize="18sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="16dp"/>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>