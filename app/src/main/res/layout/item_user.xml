<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/lavender"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- אווטאר -->
        <ImageView
            android:id="@+id/iv_user_profile_pic"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            android:background="@drawable/rounded_image_background"
            android:clipToOutline="true"/>

        <!-- פרטים -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- שם + תגיות -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp">

                <TextView
                    android:id="@+id/tv_item_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_purple"
                    tools:text="sarah_k"/>

                <TextView
                    android:id="@+id/tv_me_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="אני"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:background="@drawable/badge_background"
                    android:backgroundTint="@color/medium_purple"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:visibility="gone"
                    tools:visibility="visible"/>

                <TextView
                    android:id="@+id/tv_user_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="לא פעיל ⛔"
                    android:textSize="12sp"
                    android:textColor="#E53935"
                    android:textStyle="bold"
                    android:background="@drawable/badge_background"
                    android:backgroundTint="#fdecea"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:visibility="gone"
                    tools:visibility="visible"/>

            </LinearLayout>

            <!-- שם מלא -->
            <TextView
                android:id="@+id/tv_item_user_fullname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/dark_purple"
                android:layout_marginBottom="2dp"
                tools:text="שרה כהן"/>

            <!-- אימייל -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@android:drawable/ic_dialog_email"
                    android:layout_marginEnd="4dp"
                    app:tint="@color/text_muted"/>

                <TextView
                    android:id="@+id/tv_item_user_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    tools:text="sarah@example.com"/>

            </LinearLayout>

            <!-- טלפון -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@android:drawable/sym_action_call"
                    android:layout_marginEnd="4dp"
                    app:tint="@color/text_muted"/>

                <TextView
                    android:id="@+id/tv_item_user_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    tools:text="050-1234567"/>

            </LinearLayout>

        </LinearLayout>

        <!-- כפתורי פעולה -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp">

            <!-- הפוך לאדמין -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_make_admin"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="הפוך לאדמין"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/medium_purple"
                android:backgroundTint="@color/lavender"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginBottom="6dp"
                app:cornerRadius="8dp"/>

            <!-- שורת אייקונים -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete_user"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/baseline_block_24"
                    app:iconSize="16dp"
                    app:iconTint="#E53935"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:backgroundTint="#fdecea"
                    app:cornerRadius="8dp"
                    android:layout_marginEnd="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_Info_user"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/baseline_info_outline_24"
                    app:iconSize="16dp"
                    app:iconTint="@color/medium_purple"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:backgroundTint="@color/lavender"
                    app:cornerRadius="8dp"
                    android:layout_marginEnd="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_chat_user"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_chat"
                    app:iconSize="16dp"
                    app:iconTint="@color/dark_purple"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:backgroundTint="@color/light_purple"
                    app:cornerRadius="8dp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>