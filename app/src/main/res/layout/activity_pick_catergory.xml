<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_lavender">

    <!-- ===== Header ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/dark_purple"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="הוספת תרומה"
            android:textSize="22sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"/>

        <!-- סרגל שלבים -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center_vertical">

            <TextView
                style="@style/StepText"
                android:background="@drawable/step_indicator_active"
                android:text="1"
                android:textColor="@color/dark_purple"/>

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:background="@color/lavender"
                android:alpha="0.4"/>

            <TextView
                style="@style/StepText"
                android:background="@drawable/step_indicator_idle"
                android:text="2"
                android:textColor="@color/lavender"
                android:alpha="0.5"/>

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:background="@color/lavender"
                android:alpha="0.4"/>

            <TextView
                style="@style/StepText"
                android:background="@drawable/step_indicator_idle"
                android:text="3"
                android:textColor="@color/lavender"
                android:alpha="0.5"/>

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:background="@color/lavender"
                android:alpha="0.4"/>

            <TextView
                style="@style/StepText"
                android:background="@drawable/step_indicator_idle"
                android:text="4"
                android:textColor="@color/lavender"
                android:alpha="0.5"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ===== תוכן ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="בחרו קטגוריה לתרומה"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_muted"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:layout_gravity="right"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategories"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="12dp"/>

</LinearLayout>