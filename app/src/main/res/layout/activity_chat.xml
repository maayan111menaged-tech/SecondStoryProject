<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_lavender">

    <!-- ====== Header ====== -->
    <LinearLayout
        android:id="@+id/layout_chat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="@color/dark_purple"
        android:elevation="4dp"
        android:layoutDirection="rtl">

        <!-- אווטאר -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_chat_avatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_profile"
            android:scaleType="centerCrop"
            android:padding="3dp"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            app:strokeColor="@color/lavender"
            app:strokeWidth="1.5dp"/>

        <!-- שם + תרומה + סטטוס -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- שם -->
            <TextView
                android:id="@+id/tv_chat_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/light_lavender"/>

            <!-- שם תרומה — לחיץ, רק לצ'אטי תרומה -->
            <TextView
                android:id="@+id/tv_header_donation_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/lavender"
                android:textStyle="bold"
                android:paddingVertical="2dp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="📦 ספה ישנה"/>

            <!-- שורת סטטוס -->
            <LinearLayout
                android:id="@+id/layout_status_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_status_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    tools:text="⚠️"/>

                <TextView
                    android:id="@+id/tv_chat_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/lavender"
                    tools:text="משתמש זה אינו פעיל"/>

            </LinearLayout>

        </LinearLayout>

        <!-- כפתור מחיקה -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_chat"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="מחק שיחה"
            android:textColor="@color/lavender"
            android:visibility="gone"
            tools:visibility="visible"/>

        <!-- חץ חזור -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_arrow_right"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/light_lavender"
            android:contentDescription="חזור"/>

    </LinearLayout>

    <!-- ====== באנר MATCH ====== -->
    <LinearLayout
        android:id="@+id/layout_match_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#E8F5E9"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎁 בחר/י נמען לתרומה"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"/>

            <TextView
                android:id="@+id/tv_match_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#2E7D32"
                tools:text="לחץ ✓ Match כדי לאשר את המקבל"/>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_match"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ Match"
            android:textColor="@android:color/white"
            android:backgroundTint="#2E7D32"
            android:minWidth="0dp"
            android:paddingHorizontal="20dp"
            app:cornerRadius="12dp"/>

    </LinearLayout>

    <!-- ====== הודעות ====== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"/>

    <!-- ====== שורת שליחה ====== -->
    <LinearLayout
        android:id="@+id/layout_message_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:elevation="4dp"
        android:layoutDirection="rtl">

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="כתוב הודעה..."
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:padding="10dp"
            android:background="@drawable/bg_message_input"
            android:layout_marginStart="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="שלח"
            android:backgroundTint="@color/dark_purple"
            android:textColor="@color/light_lavender"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            app:cornerRadius="12dp"/>

    </LinearLayout>

</LinearLayout>