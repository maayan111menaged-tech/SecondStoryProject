<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_lavender"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Header ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/dark_purple"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="הוספת תרומה"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:gravity="center_vertical">

                <TextView style="@style/StepText"
                    android:background="@drawable/step_indicator_done"
                    android:text="✓" android:textColor="@color/white"/>
                <View android:layout_width="24dp" android:layout_height="1dp"
                    android:background="@color/lavender" android:alpha="0.4"/>
                <TextView style="@style/StepText"
                    android:background="@drawable/step_indicator_done"
                    android:text="✓" android:textColor="@color/white"/>
                <View android:layout_width="24dp" android:layout_height="1dp"
                    android:background="@color/lavender" android:alpha="0.4"/>
                <TextView style="@style/StepText"
                    android:background="@drawable/step_indicator_done"
                    android:text="✓" android:textColor="@color/white"/>
                <View android:layout_width="24dp" android:layout_height="1dp"
                    android:background="@color/lavender" android:alpha="0.4"/>
                <TextView style="@style/StepText"
                    android:background="@drawable/step_indicator_active"
                    android:text="4" android:textColor="@color/dark_purple"/>

            </LinearLayout>
        </LinearLayout>

        <!-- ===== תוכן ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="בדקו את פרטי התרומה"
                android:textSize="17sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="12dp"/>

            <!-- כרטיס תצוגה מקדימה -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/lavender"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- תמונה -->
                    <ImageView
                        android:id="@+id/imgPreview"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- שם -->
                        <TextView
                            android:id="@+id/tvPreviewName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_purple"
                            android:layout_marginBottom="8dp"/>

                        <!-- קו הפרדה -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/lavender"
                            android:layout_marginBottom="10dp"/>

                        <!-- קטגוריה -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="קטגוריה:"
                                android:textSize="15sp"
                                android:textColor="@color/text_muted"
                                android:layout_marginStart="8dp"/>

                            <TextView
                                android:id="@+id/tvPreviewCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textColor="@color/dark_purple"
                                android:textStyle="bold"
                                android:layout_marginStart="10dp"/>

                        </LinearLayout>

                        <!-- עיר -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="עיר:"
                                android:textSize="15sp"
                                android:textColor="@color/text_muted"
                                android:layout_marginStart="8dp"/>

                            <TextView
                                android:id="@+id/tvPreviewCity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textColor="@color/dark_purple"
                                android:textStyle="bold"
                                android:layout_marginStart="10dp"/>

                        </LinearLayout>

                        <!-- תיאור -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="תיאור:"
                            android:textSize="15sp"
                            android:textColor="@color/text_muted"
                            android:layout_marginBottom="4dp"
                            android:layout_marginStart="8dp"/>

                        <TextView
                            android:id="@+id/tvPreviewDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:gravity="end"
                            android:textColor="@color/dark_purple"
                            android:lineSpacingExtra="3dp"/>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- כפתור פרסום -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmDonation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="פרסמו את התרומה"
                android:textSize="17sp"
                android:backgroundTint="@color/dark_purple"
                android:textColor="@color/light_lavender"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>