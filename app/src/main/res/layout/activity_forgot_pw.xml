<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_lavender"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Header סגול ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/dark_purple"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="28dp"
            android:paddingHorizontal="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_arrow_right"
                android:tint="@color/lavender"
                android:layout_gravity="left"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="חזור"/>

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/logonobackground"
                android:background="@drawable/circle_background"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="עדכון סיסמה"
                android:textSize="30sp"
                android:textColor="@color/white"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="נאמת את זהותך ונאפס את הסיסמה"
                android:textSize="17sp"
                android:textColor="@color/lavender"
                android:layout_marginTop="4dp"
                android:alpha="0.85"/>

        </LinearLayout>

        <!-- ===== גוף הטופס ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- כותרת שלב 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="אימות זהות"
                android:textSize="16sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="10dp"/>

            <!-- שם משתמש -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/usernameInput_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="שם משתמש"
                android:layout_marginBottom="12dp"
                app:boxStrokeColor="@color/lavender"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="@color/text_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/usernameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/dark_purple"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- אימייל -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailInput_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="אימייל"
                android:layout_marginBottom="20dp"
                app:boxStrokeColor="@color/lavender"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="@color/text_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/dark_purple"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- קו הפרדה -->
            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/lavender"
                android:layout_marginBottom="20dp"/>

            <!-- כותרת שלב 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="סיסמה חדשה"
                android:textSize="16sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="10dp"/>

            <!-- סיסמה חדשה -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordInput_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="סיסמה חדשה"
                android:layout_marginBottom="12dp"
                app:endIconMode="password_toggle"
                app:boxStrokeColor="@color/lavender"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="@color/text_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/dark_purple"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- אימות סיסמה -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/confirmPasswordInput_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="אימות סיסמה"
                android:layout_marginBottom="24dp"
                app:endIconMode="password_toggle"
                app:boxStrokeColor="@color/lavender"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="@color/text_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/confirmPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/dark_purple"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- כפתור עדכון -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_changePw"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="עדכון סיסמה"
                android:textSize="18sp"
                android:backgroundTint="@color/dark_purple"
                android:textColor="@color/light_lavender"
                app:cornerRadius="12dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>