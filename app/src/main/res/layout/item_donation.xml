<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/lavender"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- תמונת התרומה — החלף את ה-LinearLayout הראשון בזה -->
        <ImageView
            android:id="@+id/img_donation"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_giving_heart"
            android:background="@drawable/rounded_image_background"
            android:clipToOutline="true"/>
        <!-- פרטים -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- שם + תג שלי -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_donation_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_purple"
                    tools:text="כיסא עבודה ארגונומי"/>

                <TextView
                    android:id="@+id/tv_mine_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/badge_background"
                    android:backgroundTint="@color/medium_purple"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="שלי"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible"/>

            </LinearLayout>

            <!-- קטגוריה -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_tag"
                    android:layout_marginEnd="4dp"
                    app:tint="@color/text_muted"/>

                <TextView
                    android:id="@+id/tv_donation_category2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_muted"
                    tools:text="ריהוט"/>

            </LinearLayout>

            <!-- עיר -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_location"
                    android:layout_marginEnd="4dp"
                    app:tint="@color/text_muted"/>

                <TextView
                    android:id="@+id/tv_donation_city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_muted"
                    tools:text="ירושלים"/>

            </LinearLayout>

        </LinearLayout>

        <!-- חץ ימני -->
        <LinearLayout
            android:id="@+id/btn_more_info"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="@drawable/badge_background"
            android:backgroundTint="@color/light_purple"
            android:gravity="center"
            android:layout_marginStart="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/medium_purple"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>