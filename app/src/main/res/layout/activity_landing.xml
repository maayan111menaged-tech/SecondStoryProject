<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_lavender"
    android:layoutDirection="rtl">

    <!-- עיגול עליון -->
    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="-60dp"
        android:layout_marginStart="-60dp"
        android:background="@drawable/circle_bg_top"/>

    <!-- עיגול תחתון -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="-100dp"
        android:layout_marginEnd="-100dp"
        android:background="@drawable/circle_bg_bottom"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="28dp"
        android:paddingTop="80dp"
        android:paddingBottom="48dp">

        <!-- לוגו -->
        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/logonobackground"
            android:background="@drawable/circle_background_dark"
            android:padding="12dp"
            android:layout_marginBottom="20dp"/>

        <!-- כותרת -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="מעניקים לחפצים"
            android:textSize="20sp"
            android:textColor="@color/dark_purple"
            android:textStyle="bold"
            android:fontFamily="@font/noot"
            android:layout_marginBottom="-25dp"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="סיפור שני"
            android:textSize="60sp"
            android:textColor="@color/dark_purple"
            android:textStyle="bold"
            android:fontFamily="@font/gadialmogregularaaa"
            android:gravity="center"/>

        <!-- תיאור -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="הצטרפו לקהילה שמאמינה\nשלכל חפץ מגיע סיפור שני"            android:textSize="20sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"/>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- כפתור הרשמה -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_Landing_toSignUp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="הרשמה"
            android:textSize="15sp"
            android:backgroundTint="@color/dark_purple"
            android:textColor="@color/light_lavender"
            android:layout_marginBottom="12dp"
            app:cornerRadius="12dp"/>

        <!-- כפתור כניסה -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_Landing_toLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="כניסה למשתמש קיים"
            android:textSize="15sp"
            android:backgroundTint="@android:color/transparent"
            android:textColor="@color/dark_purple"
            app:strokeColor="@color/dark_purple"
            app:strokeWidth="1.5dp"
            app:cornerRadius="12dp"/>

    </LinearLayout>

</FrameLayout>