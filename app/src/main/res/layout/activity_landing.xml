<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f7d9ff"
    tools:context=".screens.LandingActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- עיגול רקע עליון -->
        <View
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="-60dp"
            android:background="@drawable/circle_bg_top" />

        <!-- עיגול רקע תחתון -->
        <View
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="-60dp"
            android:layout_marginStart="-60dp"
            android:background="@drawable/circle_bg_bottom" />

        <!-- תמונת הספר בתחתית -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_gravity="bottom"
            android:layout_marginBottom="-30dp"
            android:alpha="0.2"
            app:srcCompat="@drawable/bookwithflowers" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- כותרות -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp">

                <TextView
                    android:id="@+id/littleTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/akitrg__"
                    android:text="מעניקים לחפצים"
                    android:textColor="#33083f"
                    android:textSize="23pt"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/littleTitle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="-3dp"
                    android:layout_marginTop="-3dp"
                    android:fontFamily="@font/akitrg__"
                    android:text="מעניקים לחפצים"
                    android:textColor="#a855c8"
                    android:textSize="23pt"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/bigTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/noot"
                    android:text="סיפור שני"
                    android:textColor="#a855c8"
                    android:textSize="23pt"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bigTitle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="-5dp"
                    android:layout_marginTop="-5dp"
                    android:fontFamily="@font/noot"
                    android:text="סיפור שני"
                    android:textColor="#33083f"
                    android:textSize="23pt"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Spacer גמיש שדוחף כפתורים לתחתית -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- כפתור הרשמה -->
            <Button
                android:id="@+id/btn_Landing_toSignUp"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#33083f"
                android:fontFamily="@font/akitrg__"
                android:text="הרשמה"
                android:textColor="#f7d9ff"
                android:textSize="16pt"/>

            <!-- כפתור כניסה -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_Landing_toLogin"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="100dp"
                android:backgroundTint="@android:color/transparent"
                android:fontFamily="@font/akitrg__"
                android:text="כניסה למשתמש קיים"
                android:textColor="#33083f"
                android:textSize="16pt"
                app:strokeColor="#33083f"
                app:strokeWidth="2dp"/>

        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>