<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_lavender"
    android:layoutDirection="rtl"
    tools:context=".screens.LeaderBoardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== כותרת ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="קהילה"
                android:textSize="17sp"
                android:textColor="@color/text_muted"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="לוח מובילים"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="@color/dark_purple"
                android:layout_marginTop="2dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/badge_background"
                android:backgroundTint="@color/lavender"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_giving_heart"
                    android:layout_marginEnd="6dp"
                    app:tint="@color/medium_purple"/>

                <TextView
                    android:id="@+id/tv_user_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 תורמים"
                    android:textSize="15sp"
                    android:textColor="@color/medium_purple"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ===== פודיום ===== -->
        <LinearLayout
            android:id="@+id/podium_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:gravity="bottom">

            <!-- מקום 2 -->
            <LinearLayout
                android:id="@+id/podium_item_2"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:cardCornerRadius="27dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#B0BEC5"
                    app:strokeWidth="2dp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/iv_podium_2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        />

                </com.google.android.material.card.MaterialCardView>

                <TextView

                    android:id="@+id/tv_podium_2_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="17sp"
                    android:textColor="@color/dark_purple"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tv_podium_2_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/podium_silver"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"/>

                </LinearLayout>

            </LinearLayout>

            <!-- מקום 1 -->
            <LinearLayout
                android:id="@+id/podium_item_1"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_crown"
                    android:layout_marginBottom="4dp"
                    app:tint="#FFD700"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#FFD700"
                    app:strokeWidth="2dp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/iv_podium_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_podium_1_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="17sp"
                    android:textColor="@color/dark_purple"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tv_podium_1_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:background="@drawable/podium_gold"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textSize="35sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"/>

                </LinearLayout>

            </LinearLayout>

            <!-- מקום 3 -->
            <LinearLayout
                android:id="@+id/podium_item_3"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:cardCornerRadius="27dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#CD7F32"
                    app:strokeWidth="2dp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/iv_podium_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_podium_3_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="17sp"
                    android:textColor="@color/dark_purple"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tv_podium_3_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/podium_bronze"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ===== כותרת רשימה ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="שאר המובילים"
            android:textSize="13sp"
            android:textColor="@color/text_muted"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="6dp"/>

        <!-- ===== רשימה ===== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_users_list_leader_board"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_user_leader_board"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>